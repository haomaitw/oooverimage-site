:8080 {
    root * /usr/share/caddy
    encode gzip zstd
    header /deployment-version.json Cache-Control "no-store"
    @htmlExt {
        not path */
        not file {path}
        file {path}.html
    }
    rewrite @htmlExt {path}.html
    file_server
    handle_errors 404 {
        rewrite * /404.html
        file_server
    }
    log {
        output stderr
    }
}
